MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10350a1b7d467784491ed0fb9c48c9f6, type: 3}
  m_Name: LendaIncinerajaNao
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: c0d71f1534a4dcc468bbb9c8196e348f, type: 2}
    text: "Acho que n\xE3o... Parece ser MUITO LEGAL!!!"
  - speaker: {fileID: 11400000, guid: 7de05702be1743d4c91e09edb76cd6fc, type: 2}
    text: "Pode apostar que \xE9 legal..."
  - speaker: {fileID: 11400000, guid: 7de05702be1743d4c91e09edb76cd6fc, type: 2}
    text: "Dizem que Incineraja \xE9 um eco extremamente forte, capaz de causar inc\xEAndios
      enormes e de apaga-los em um piscar de olhos..."
  - speaker: {fileID: 11400000, guid: 7de05702be1743d4c91e09edb76cd6fc, type: 2}
    text: "Ela \xE9 respons\xE1vel por guardar a natureza, paralisando de medo todos
      que olham para ela..."
  - speaker: {fileID: 11400000, guid: 7de05702be1743d4c91e09edb76cd6fc, type: 2}
    text: "Dizem que ela desistiu de guardar a natureza por conta da explora\xE7\xE3o
      massiva da humanidade, mas ela algum dia vai voltar para ajudar novamente,
      ela apenas precisa encontrar uma pessoa que tenha a mesma vontade que ela..."
  - speaker: {fileID: 11400000, guid: c0d71f1534a4dcc468bbb9c8196e348f, type: 2}
    text: Uou... Que maneiro...
  - speaker: {fileID: 11400000, guid: 7de05702be1743d4c91e09edb76cd6fc, type: 2}
    text: Eu avisei que seria legal...
  options: []
  requiredNPCs: []
  requiredLocations: []
  isBattle: 0
